# Database (required for Prisma – app will load with empty data if missing)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Optional: base URL for links in emails and redirects (defaults to http://localhost:3000)
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin (optional for local dev)
# ADMIN_PASSWORD="your-admin-password"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_SECRET="random-secret-for-admin-session"

# NextAuth.js (required for user authentication)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generate-with-openssl-rand-base64-32>"

# Google OAuth (required for Google Sign-In)
GOOGLE_CLIENT_ID="<from-google-cloud-console>"
GOOGLE_CLIENT_SECRET="<from-google-cloud-console>"

# Stripe (optional until you use checkout)
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (optional until you send emails)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="notifications@yourdomain.com"

# StockX price API (optional)
# RAPIDAPI_KEY="..."
# RAPIDAPI_HOST="..."
